# Settings for lyfe-backup. Written once by install.sh; edit freely.
# No secrets go in this file: the two below are files it points at.
#
# The bucket is reached over the S3 protocol. For Supabase Storage, the
# endpoint and region are on the project's Storage > S3 page:
#   https://<project-ref>.storage.supabase.co/storage/v1/s3
LYFE_BACKUP_S3_ENDPOINT=
LYFE_BACKUP_S3_REGION=
# A private bucket used for nothing else.
LYFE_BACKUP_BUCKET=

# The S3 access key: the key ID on line 1, the secret on line 2.
#LYFE_BACKUP_S3_KEY_FILE=@HOME@/.config/lyfe/backup-s3-key
# The passphrase every backup is encrypted with. Keep a copy of it
# somewhere other than this machine.
#LYFE_BACKUP_PASSPHRASE_FILE=@HOME@/.config/lyfe/backup-passphrase
