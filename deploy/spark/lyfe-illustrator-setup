#!/usr/bin/env bash
# Sets up the meal illustrator under the `lyfe` account: a Python of its
# own with PyTorch and diffusers, and a copy of FLUX.2 klein 4B (Apache 2.0,
# not gated). Run it once after installing step 7; running it again
# changes nothing that is already in place.
#
#   lyfe-illustrator-setup
#
# About 6 GB of Python packages and 15 GB of model, all in ~/illustrator.
# The model is downloaded here once; after that the illustrator never goes
# to the network. Until this has finished, meals keep their photos.
set -euo pipefail
umask 077

ILLUSTRATOR=$HOME/illustrator
VENV=$ILLUSTRATOR/venv
# The versions and model revision tried on the Spark for ADR 0005.
MODEL=black-forest-labs/FLUX.2-klein-4B
REVISION=e7b7dc27f91deacad38e78976d1f2b499d76a294
TORCH="torch==2.14.1"
TORCH_INDEX=https://download.pytorch.org/whl/cu130
PACKAGES=(diffusers==0.43.0 transformers==5.23.0 accelerate==1.16.0 safetensors==0.8.0 tokenizers==0.23.3
          pillow==13.0.0 sentencepiece==0.2.3 protobuf==7.36.2 huggingface_hub==2.4.0)

mkdir -p "$ILLUSTRATOR"
rm -f "$ILLUSTRATOR/ready"

if [ ! -x "$VENV/bin/python" ]; then
    echo "== Making a Python for the illustrator"
    python3 -m venv "$VENV"
fi
echo "== Installing PyTorch and diffusers (about 6 GB the first time)"
"$VENV/bin/pip" install -q --upgrade pip
"$VENV/bin/pip" install -q "$TORCH" --index-url "$TORCH_INDEX"
"$VENV/bin/pip" install -q "${PACKAGES[@]}"

echo "== Checking the GPU can be used from this account"
"$VENV/bin/python" -I - <<'PY'
import torch, diffusers
assert torch.cuda.is_available(), "PyTorch cannot see the GPU from this account"
assert hasattr(diffusers, "Flux2KleinPipeline"), "this diffusers has no Flux2KleinPipeline"
print("  torch", torch.__version__, "on", torch.cuda.get_device_name(0), "/ diffusers", diffusers.__version__)
PY

echo "== Downloading $MODEL (about 15 GB the first time)"
HF_HOME=$ILLUSTRATOR/hf HF_HUB_DISABLE_TELEMETRY=1 "$VENV/bin/python" -I - "$MODEL" "$REVISION" <<'PY'
import sys
from huggingface_hub import snapshot_download
path = snapshot_download(sys.argv[1], revision=sys.argv[2])
print("  in", path)
PY

[ -e "$ILLUSTRATOR/lyfe-illustrate.py" ] || { echo "lyfe-illustrate.py is missing; run deploy/spark/install.sh first" >&2; exit 1; }
"$VENV/bin/python" -I "$ILLUSTRATOR/lyfe-illustrate.py" --self-test | sed 's/^/  /'
touch "$ILLUSTRATOR/ready"
cat <<NOTE

The illustrator is set up. lyfe-server starts it by itself when a photo is
waiting and at least 24 GB of memory are free; meals logged before now are
drawn too. To try it on one photo first (about two minutes, most of it
loading the model):

  set -a; . ~/.config/lyfe/lyfe.env; set +a
  ~/bin/lyfe-server illustration-check <photo.jpg> --note "<one line>" --out /tmp/meal.png
NOTE
