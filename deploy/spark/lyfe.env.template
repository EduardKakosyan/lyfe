# Settings for the lyfe backend. Written once by install.sh; edit freely,
# then: systemctl --user restart lyfe-server
# No secrets go in this file: the Garmin key and the SimpleFIN access
# address are referenced by path.

LYFE_DATABASE_URL=postgres://lyfe@localhost/lyfe?host=@RUNTIME_DIR@/lyfe-postgres
LYFE_LISTEN_ADDR=127.0.0.1:8787

# Decides what "today" and "this week" mean.
LYFE_TIMEZONE=@TIMEZONE@

LYFE_GARMIN_KEY_FILE=@HOME@/.config/lyfe/garmin-api-key

# Money. The access address SimpleFIN Bridge issued, written once by
# `lyfe-server money-connect` (see the README). Without the file the server
# runs and imports nothing.
LYFE_SIMPLEFIN_ACCESS_FILE=@HOME@/.config/lyfe/simplefin-access
# Hours between imports, days of history asked for the first time, and
# days re-read every time after (defaults shown). The bridge refreshes
# about once a day and allows about 24 requests a day.
#LYFE_MONEY_SYNC_HOURS=6
#LYFE_MONEY_BACKFILL_DAYS=180
#LYFE_MONEY_WINDOW_DAYS=14
# The currency totals are in. Unset, the one most accounts are in.
#LYFE_MONEY_CURRENCY=

# What counts as a gym session (defaults shown).
#LYFE_GYM_ACTIVITY_TYPES=strength_training,indoor_cardio,hiit,lap_swimming,open_water_swimming,running,treadmill_running,cycling,indoor_cycling,elliptical,stair_climbing,indoor_rowing
#LYFE_GYM_MIN_MINUTES=15

# Breath training. The first table, and when the rounds get longer
# (defaults shown). After the first session the table follows what was
# recorded, so the first two only matter before it.
#LYFE_BREATH_START_ROUND_SECONDS=240
#LYFE_BREATH_ROUNDS=6
#LYFE_BREATH_ADVANCE_UNDER_SECONDS=45
#LYFE_BREATH_STEP_SECONDS=15

# Notifications. The key is the .p8 file Apple issues in the developer
# account (Certificates, Identifiers & Profiles > Keys, with Apple Push
# Notifications service enabled). Keep Apple's file name and the key ID is
# read from it. Without these the server runs and sends nothing.
#LYFE_APNS_KEY_FILE=@HOME@/.config/lyfe/AuthKey_XXXXXXXXXX.p8
#LYFE_APNS_TEAM_ID=
# Prompts are only sent between these hours of your day (defaults shown).
#LYFE_NOTIFY_FROM_HOUR=7
#LYFE_NOTIFY_UNTIL_HOUR=18

# Weigh-ins. The unit weights are typed and shown in (kg or lb), and when
# the morning prompt goes out in your time zone, or off (defaults shown).
# Weights are stored in grams, so changing the unit changes only the display.
#LYFE_WEIGHT_UNIT=lb
#LYFE_WEIGH_IN_AT=06:30

# Food. From this time of your day, a logging streak with nothing logged
# yet is prompted for once, or off for no prompt (default shown). It is
# also held to the hours prompts are sent between. The calorie and protein
# targets are not settings: you type them in the app.
#LYFE_FOOD_PROMPT_AT=12:00

# Photo meals. They are estimated by a vision model in this machine's
# Ollama, loaded only when a photo is waiting and only when this much memory
# is free, with its context capped, and let go a couple of minutes after
# the last photo. LYFE_OLLAMA_URL=off stops estimates; photo meals are then
# typed in by hand. The range is how far either way an estimate is shown
# to be (defaults shown).
#LYFE_OLLAMA_URL=http://127.0.0.1:11434
#LYFE_PHOTO_MODEL=gemma4:31b
#LYFE_PHOTO_CONTEXT=8192
#LYFE_PHOTO_MIN_FREE_GB=32
#LYFE_PHOTO_KEEP_ALIVE_SECONDS=120
#LYFE_PHOTO_RANGE_PERCENT=35

# Meal illustrations and food icons. Each photo meal is drawn as a Poster
# illustration, and each food looked at in the catalogue as a small icon, by
# FLUX.2 klein 4B, in a program set up once by lyfe-illustrator-setup. It is
# started only when a picture is waiting and this much memory is free, draws
# every one waiting, and exits a few minutes after the last, giving its
# memory back. LYFE_ILLUSTRATOR=off stops it; meals then keep their photos
# and foods have no icons (defaults shown).
#LYFE_ILLUSTRATOR=~/bin/lyfe-illustrate
#LYFE_ILLUSTRATION_MIN_FREE_GB=24
#LYFE_ILLUSTRATION_KEEP_ALIVE_SECONDS=180
